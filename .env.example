BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_IDS=123456789
SUPER_ADMIN_ID=123456789

# Початковий секрет запрошення (далі змінюється з адмін-панелі й зберігається в БД)
INVITE_SECRET=change_me

# Шлях до SQLite відносно робочої папки. У Docker це /app/data/helpdesk.db (WORKDIR /app)
DB_PATH=data/helpdesk.db
